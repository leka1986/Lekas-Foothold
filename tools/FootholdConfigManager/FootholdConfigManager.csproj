<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FootholdConfigManager</AssemblyName>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/ManagerVersion.txt').Trim())</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>FootholdConfigManager.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <FootholdBuildMode Condition="Exists('EmbeddedBuildMode.txt')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/EmbeddedBuildMode.txt').Trim())</FootholdBuildMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FootholdBuildMode)' == 'user'">
    <DefineConstants>$(DefineConstants);FOOTHOLD_USER_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Loretta.CodeAnalysis.Lua" Version="0.2.13" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="apache-sunset-source.jpg;apache-action-source.png;carrier-launch-source.jpg;foothold-manager-icon.png" LogicalName="FootholdConfigManager.Splash.%(Filename)%(Extension)" />
    <EmbeddedResource Include="CloudPreviewManifest.txt" LogicalName="FootholdConfigManager.CloudPreviews.Manifest" />
    <EmbeddedResource Include="WarehouseWeaponIds.txt" LogicalName="FootholdConfigManager.WarehouseWeaponIds" />
    <EmbeddedResource Include="WarehouseWeaponAircraft.txt" LogicalName="FootholdConfigManager.WarehouseWeaponAircraft" />
    <EmbeddedResource Include="altocumulus1.png;altocumulus2.png;altocumulus3.png;altocumulus4.png;altostratus1.png;altostratus2.png;altostratus3.png;altostratus4.png;atmosx_default_thumb.png;cirrocumulus1.png;cirrocumulus2.png;cirrocumulus3.png;cirrostratus1.png;cirrostratus2.png;cirrostratus3.png;cirrostratus4.png;cirrostratus5.png;cloud_1.png;cloud_10.png;cloud_11.png;cloud_12.png;cloud_13.png;cloud_14.png;cloud_15.png;cloud_16.png;cloud_17.png;cloud_18.png;cloud_19.png;cloud_2.png;cloud_20.png;cloud_21.png;cloud_22.png;cloud_23.png;cloud_24.png;cloud_25.png;cloud_26.png;cloud_27.png;cloud_28.png;cloud_29.png;cloud_3.png;cloud_30.png;cloud_31.png;cloud_32.png;cloud_33.png;cloud_34.png;cloud_4.png;cloud_5.png;cloud_6.png;cloud_7.png;cloud_8.png;cloud_9.png;cumulus1.png;cumulus2.png;cumulus3.png;cumulus4.png;cumulus5.png;cumulusaltomixed.png;empty.png;nimbostratus1.png;overcastcumulus.png;OvercastRain1.png;OvercastRain2.png;OvercastRain3.png;Preset81.png;Preset82.png;Preset83.png;Preset84.png;Preset85.png;Preset86.png;Preset87.png;Preset88.png;ScatteredShowers1.png;ScatteredShowers2.png;ScatteredShowers3.png;ScatteredShowers4.png;ScatteredShowers5.png;stratus1.png;stratus2.png;stratus3.png;stratus4.png;stratus5.png;stratus6.png;stratus7.png;tstorm1.png" LogicalName="FootholdConfigManager.CloudPreviews.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="backups\**\*.cs" />
    <Compile Remove="StabilityRegressionSelfTest.cs;MainForm.PerformanceProbe.cs;MainForm.PreviewStartup.cs;SignedRelease*.cs;MainForm.SignedRelease.cs" Condition="'$(FootholdBuildMode)' == 'user'" />
    <EmbeddedResource Remove="backups\**\*.resx" />
    <EmbeddedResource Include="Foothold Config.gui.json" LogicalName="FootholdConfigManager.DefaultGuiMetadata.json" Condition="Exists('Foothold Config.gui.json') And ('$(FootholdBuildMode)' != 'user' Or !Exists('EmbeddedGuiMetadata.json'))" />
    <EmbeddedResource Include="EmbeddedGuiMetadata.json" LogicalName="FootholdConfigManager.EmbeddedGuiMetadata.json" Condition="Exists('EmbeddedGuiMetadata.json')" />
    <EmbeddedResource Include="EmbeddedBuildMode.txt" LogicalName="FootholdConfigManager.EmbeddedBuildMode.txt" Condition="Exists('EmbeddedBuildMode.txt')" />
    <EmbeddedResource Include="ManagerVersion.txt" LogicalName="FootholdConfigManager.ManagerVersion.txt" />
    <EmbeddedResource Include="ThirdPartyNotices.txt" LogicalName="FootholdConfigManager.ThirdPartyNotices.txt" />
    <EmbeddedResource Include="../test-configs/Foothold Config.lua" LogicalName="FootholdConfigManager.Preview.Foothold Config.lua" Condition="'$(FootholdBuildMode)' != 'user'" />
    <EmbeddedResource Include="../test-configs/Foothold Config WW2.lua" LogicalName="FootholdConfigManager.Preview.Foothold Config WW2.lua" Condition="'$(FootholdBuildMode)' != 'user'" />
  </ItemGroup>
</Project>
